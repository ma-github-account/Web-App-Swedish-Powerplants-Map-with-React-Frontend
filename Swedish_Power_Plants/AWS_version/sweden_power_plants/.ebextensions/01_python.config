option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: backend.wsgi:application
  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true

container_commands:
  01_migrate:
    # `source /var/app/venv/*/bin/activate` is required - without it `python`
    # is the system interpreter and Django is not importable.
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    # --clear so a previous deploy's hashed filenames cannot linger and shadow
    # the current build.
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput --clear"
    leader_only: true
