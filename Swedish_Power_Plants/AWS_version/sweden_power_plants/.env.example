# AWS edition - template only. No real values belong in this file.
#
# On Elastic Beanstalk these are set with `eb setenv`, never from a file:
#
#   eb setenv IS_PRODUCTION=true SECRET_KEY=... NAME=... DB_USER=... \
#             PASSWORD=... HOST=... AWS_ACCESS_KEY_ID=... \
#             AWS_SECRET_ACCESS_KEY=... AWS_STORAGE_BUCKET_NAME=...
#
# To run against AWS from your own machine, copy this to .env and fill it in.
# .env is gitignored and must never be committed.
#
# Variable names match the other Elastic Beanstalk projects in this account, so
# one `eb setenv` recipe works across all of them.

# true on Elastic Beanstalk: turns DEBUG off, restricts CORS, and switches on
# WhiteNoise's hashed and compressed static storage.
IS_PRODUCTION=true

# Required - the app refuses to start without it. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated. Must include your domain. The load balancer health-checks
# the instance by its private IP, so leave blank (meaning '*') or add it.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- RDS (PostgreSQL) ------------------------------------------------------
# DB_USER, not USER: on Linux, USER already holds the OS account name, so a
# setting read from USER would silently pick up the wrong value on a server.
NAME=your-rds-database-name
DB_USER=your-rds-username
PASSWORD=
HOST=your-instance.xxxxxxxx.your-region.rds.amazonaws.com
DB_PORT=5432

# --- S3 (media only; static is served by WhiteNoise) -----------------------
# The IAM user needs read/write on the bucket. The bucket needs a public-read
# policy for images to display, and ACLs disabled (Object Ownership =
# BucketOwnerEnforced), which is the current S3 default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-2
